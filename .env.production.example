# ─────────────────────────────────────────────────────────────────────────────
# ARIS Production Environment Variables Example (.env)
# Copy this content into your GitHub Actions Secret named ARIS_ENV_FILE
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=ARIS
APP_ENV=production
APP_KEY=REPLACE_WITH_BASE64_APP_KEY
APP_DEBUG=false
APP_URL=https://api.aris.thilinarodrigo.me
APP_TIMEZONE=Asia/Colombo

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=12

# ── Database (Docker MySQL 8.4) ─────────────────────────────────────────────
# IMPORTANT: DB_HOST must be 'mysql' (the service name in docker-compose)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=aris_db
DB_USERNAME=aris_user
DB_PASSWORD=REPLACE_WITH_SECURE_DB_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_SECURE_ROOT_PASSWORD

# ── Docker Hub Integration ─────────────────────────────────────────────────
DOCKER_HUB_USERNAME=REPLACE_WITH_YOUR_DOCKERHUB_USERNAME

# ── System Admin Account Credentials (Seeded by AdminSeeder) ────────────────
SYSTEM_ADMIN_NAME="System Administrator"
SYSTEM_ADMIN_NIC="199012345678"
SYSTEM_ADMIN_MOBILE="+94771234567"
SYSTEM_ADMIN_INSTITUTION_ID=1
SYSTEM_ADMIN_PASSWORD="REPLACE_WITH_SECURE_ADMIN_PASSWORD"

# ── CORS, Sanctum & Session Security ─────────────────────────────────────────
FRONTEND_URLS=https://aris.thilinarodrigo.me,https://aris-plum.vercel.app,http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=aris.thilinarodrigo.me,aris-plum.vercel.app,localhost:5173

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_DOMAIN=.thilinarodrigo.me
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ── Cache, Filesystem & Queue ────────────────────────────────────────────────
CACHE_STORE=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
LOG_CHANNEL=stack
LOG_LEVEL=error

# ── Laravel Reverb (WebSockets) ─────────────────────────────────────────────
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=REPLACE_WITH_REVERB_APP_ID
REVERB_APP_KEY=REPLACE_WITH_REVERB_APP_KEY
REVERB_APP_SECRET=REPLACE_WITH_REVERB_APP_SECRET

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

REVERB_HOST=api.aris.thilinarodrigo.me
REVERB_PORT=8080
REVERB_SCHEME=https

# ── Twilio SMS Service ───────────────────────────────────────────────────────
TWILIO_SID=REPLACE_WITH_TWILIO_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=REPLACE_WITH_TWILIO_PHONE_NUMBER

# ── Web Push Notifications (VAPID Keys) ─────────────────────────────────────
WEB_PUSH_VAPID_SUBJECT=mailto:security@aris.thilinarodrigo.me
WEB_PUSH_VAPID_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY
WEB_PUSH_VAPID_PRIVATE_KEY=REPLACE_WITH_VAPID_PRIVATE_KEY

# ── TextIt SMS API ───────────────────────────────────────────────────────────
TEXTIT_API_KEY=REPLACE_WITH_TEXTIT_API_KEY
TEXTIT_ENDPOINT=https://api.textit.biz/
TEXTIT_API_VERSION=v1
TEXTIT_TIMEOUT=15

# ── Password Setup Link Config ──────────────────────────────────────────────
PASSWORD_SETUP_FRONTEND_URL=https://aris.thilinarodrigo.me
PASSWORD_SETUP_EXPIRES_HOURS=8
PASSWORD_SETUP_RESEND_COOLDOWN_SECONDS=60

# ── Automated Database Backups ───────────────────────────────────────────────
BACKUP_MYSQLDUMP_BINARY=/usr/bin/mysqldump
BACKUP_MYSQL_BINARY=/usr/bin/mysql
BACKUP_STORAGE_DISK=private
BACKUP_SCHEDULE_TIME=02:00
BACKUP_RETENTION_DAILY_DAYS=30
BACKUP_RETENTION_WEEKLY_DAYS=90
BACKUP_RETENTION_MONTHLY_DAYS=365
BACKUP_RESTORE_ENABLED=true
BACKUP_UPLOAD_MAX_KB=1048576

# ── Mail Configuration ───────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@aris.thilinarodrigo.me"
MAIL_FROM_NAME="${APP_NAME}"
