# ─────────────────────────────────────────────────────────────────────────────
# ARIS Production Environment Variables
# Copy this to /opt/aris/.env on the EC2 instance.
# NEVER commit the real .env to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=ARIS
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_KEY=base64:REPLACE_WITH_php_artisan_key_generate_output

# ── Database ─────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql          # Docker service name — do NOT change this
DB_PORT=3306
DB_DATABASE=aris_db
DB_USERNAME=aris_user
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_ROOT_STRONG_PASSWORD

# ── Docker Hub ───────────────────────────────────────────────────────────────
DOCKER_HUB_USERNAME=REPLACE_WITH_YOUR_DOCKERHUB_USERNAME

# ── Cache & Sessions ─────────────────────────────────────────────────────────
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ── Queue ────────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=database

# ── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=REPLACE_WITH_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@yourdomain.com
MAIL_FROM_NAME="ARIS"

# ── Laravel Reverb (WebSocket) ───────────────────────────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=REPLACE_WITH_APP_ID
REVERB_APP_KEY=REPLACE_WITH_APP_KEY
REVERB_APP_SECRET=REPLACE_WITH_APP_SECRET
REVERB_HOST=yourdomain.com
REVERB_PORT=8080
REVERB_SCHEME=https

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=error
