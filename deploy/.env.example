# Docker Hub repositories. Replace with your Docker Hub username or organization.
API_IMAGE=your-dockerhub-username/aris-api
WEB_IMAGE=your-dockerhub-username/aris-web

# GitHub Actions overrides this with the immutable commit SHA.
IMAGE_TAG=latest

# The exact host path reported by: mysqladmin variables | grep socket
MYSQL_SOCKET_HOST=/var/lib/mysql/mysql.sock
