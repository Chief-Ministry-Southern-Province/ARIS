APP_NAME=ARIS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://aris.example.gov.lk

LOG_CHANNEL=stack
LOG_LEVEL=warning

# The MySQL socket is mounted from the EC2 host at this path in containers.
DB_CONNECTION=mysql
DB_SOCKET=/var/run/mysqld/mysqld.sock
DB_DATABASE=aris
DB_USERNAME=aris_app
DB_PASSWORD=replace-with-a-long-random-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=aris.example.gov.lk
SESSION_SECURE_COOKIE=true

FRONTEND_URLS=https://aris.example.gov.lk
SANCTUM_STATEFUL_DOMAINS=aris.example.gov.lk

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=replace-with-a-random-id
REVERB_APP_KEY=replace-with-a-random-public-key
REVERB_APP_SECRET=replace-with-a-random-secret
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=aris.example.gov.lk
REVERB_PORT=443
REVERB_SCHEME=https
